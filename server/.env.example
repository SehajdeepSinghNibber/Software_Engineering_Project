# Copy this file to .env and fill in your real values.

PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017
JWT_SECRET=change-me
NODE_ENV=development

# Cloudinary (used by /api/v1/auth/update-profile)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# ML inference service (image de-hazing)
# ---------------------------------------------------------------------------

# Base URL of the Python FastAPI service (see ML/inference_service).
ML_SERVICE_URL=http://127.0.0.1:8100

# How long to wait for the ML service to answer a request (ms).
ML_TIMEOUT_MS=120000

# Maximum size of an uploaded hazy image (MB).
ML_MAX_FILE_SIZE_MB=10

# Default model used when a request does not specify one.
# One of: dehamer | aod | light_dehaze
ML_DEFAULT_MODEL=dehamer