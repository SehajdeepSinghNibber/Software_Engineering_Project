# ML inference service configuration (copy to .env or export in your shell).

# Host/port the FastAPI service listens on.
ML_HOST=127.0.0.1
ML_PORT=8100

# Default model used by POST /predict when no explicit "model" is provided.
# AOD-Net is the default trainable baseline. One of: dehamer, aod, light_dehaze
ML_MODEL_TYPE=aod

# Optional checkpoint for the default model. By default, the service looks for
# ML/checkpoints/<model>_best.pt (created by the training command in README.md).
# A per-model override can be set with ML_AOD_MODEL_PATH, ML_DEHAMER_MODEL_PATH,
# or ML_LIGHT_DEHAZE_MODEL_PATH.
# ML_MODEL_PATH=C:/path/to/aod_best.pt

# Square input size fed to the model. Must be a multiple of 8 for "dehamer".
ML_INPUT_SIZE=224

# Input normalisation: "auto" (per-model default: [-1,1] for dehamer, [0,1]
# for aod / light_dehaze), "01" or "11".
ML_INPUT_NORM=auto

# Compute device: "auto" | "cpu" | "cuda".
ML_DEVICE=auto

# Maximum accepted upload size (MB).
ML_MAX_UPLOAD_MB=10

# Cache loaded models in memory between requests.
ML_MODEL_CACHE=true