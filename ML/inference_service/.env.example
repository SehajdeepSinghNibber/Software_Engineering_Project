# ML inference service configuration (copy to .env or export in your shell).

# Host/port the FastAPI service listens on.
ML_HOST=127.0.0.1
ML_PORT=8100

# Active model used by POST /predict.
ML_MODEL_TYPE=drnet

# Download official pretrained weights with `npm run weights:drnet`.
# Default: ML/checkpoints/DRNet_3tasks.pth. Optional override:
# ML_DRNET_MODEL_PATH=C:/path/to/DRNet_3tasks.pth

# Optional DeHamer model (select with model=dehamer). Install with
# `npm run weights:dehamer`; default: ML/checkpoints/pretrained/dehamer_outdoor.pt
# ML_DEHAMER_MODEL_PATH=C:/path/to/dehamer_outdoor.pt

# DRNet square input size, divisible by 64.
ML_INPUT_SIZE=256

# Input normalisation: "auto" (DRNet expects [0, 1]), "01" or "11".
ML_INPUT_NORM=auto

# Compute device: "auto" | "cpu" | "cuda".
ML_DEVICE=auto

# Maximum accepted upload size (MB).
ML_MAX_UPLOAD_MB=10

# Cache loaded models in memory between requests.
ML_MODEL_CACHE=true
